# Copy to .env and adjust. Never commit a filled-in copy.

HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/health_checker?sslmode=disable
LOG_LEVEL=info

# --- Probing defaults (per-service values in Admin override these) ---
PROBE_INTERVAL=5s
PROBE_TIMEOUT=3s
# Consecutive confirmed failures before a target trips to critical.
FAILURES_TO_TRIP=3
# Consecutive good probes before a target is considered healthy again. Also
# governs how long a freshly started target takes to earn its first verdict:
# targets begin unknown, not healthy.
SUCCESS_TO_RECOVER=2
# Consecutive inconclusive probes before a target counts against its region's
# quorum. The unknown-side counterpart to FAILURES_TO_TRIP — without it a single
# transport blip, which hits every target at once when the fault is on the
# checker's side, can swing the unknown ratio in one tick.
UNKNOWNS_TO_DISTRUST=3

# How often health is recomputed and weights reconciled. Keep this well above
# PROBE_INTERVAL: probes gather evidence, this loop acts on it.
EVALUATE_INTERVAL=15s

# --- Leader election ---
# The probe fleet and the evaluate loop run on exactly one replica, elected via
# a Postgres advisory lock. This is how often a standby retries for the lock and
# how often the leader verifies the connection holding it, so it bounds failover
# time when a leader dies.
LEADER_POLL_INTERVAL=5s

# --- Static console bundle ---
# Directory the built frontend is served from. The container image ships it at
# /app/web. Set empty to run the API headless (e.g. against a Vite dev server).
WEB_DIR=/app/web

# --- Fail-open policy ---
# QUORUM_REQUIRED of QUORUM_TOTAL probes must be conclusive for a region's
# health signal to be trusted. The tolerated share of inconclusive probes is
# (TOTAL-REQUIRED)/TOTAL, so 2-of-3 tolerates one third going dark. REQUIRED
# must be strictly less than TOTAL; equal values tolerate nothing and would pin
# the system into a permanent fail-open hold.
QUORUM_REQUIRED=2
QUORUM_TOTAL=3
# How long last-known-good weights are held while the signal is inconclusive
# before the hold itself escalates to a critical page.
FAIL_OPEN_HOLD=10m

# --- Auth ---
# Local development only. With this set, every request runs as DEV_USER.
AUTH_DISABLED=true
DEV_USER=dev@localhost
DEV_GROUPS=sre-admins

# Production: leave AUTH_DISABLED unset and configure LDAP.
# LDAP_URL=ldaps://ldap.example.com:636
# LDAP_BIND_DN=cn=svc-health-checker,ou=services,dc=example,dc=com
# LDAP_BIND_PASSWORD_ENV=LDAP_BIND_PASSWORD
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_FILTER=(uid=%s)
# LDAP_GROUP_FILTER=(member=%s)
# LDAP_ADMIN_GROUP=sre-admins
# LDAP_CACHE_TTL=5m

# --- Frontend origin allowed to call the API with credentials ---
CORS_ORIGINS=http://localhost:5173

# --- Custom SSO credential_process binaries permitted to execute ---
# SSO_BINARY_ALLOWLIST=/opt/okta/aws-creds

# --- Envoy control plane ---
# ENVOY_XDS_ADDR=xds.internal.example.com:18000
